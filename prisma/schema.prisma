generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institute {
  id    String @id @default(uuid())
  name  String
  email String

  users       User[]
  students    Student[]
  tests       PsychometricTest[]
  userInvites UserInvite[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role

  // DEC-01: null only for SUPER_ADMIN (platform level). Every other role needs an institute. The database
  // CHECK constraint in the DEC-01 migration and the auth middleware both enforce this.
  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Restrict)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([instituteId])
}

model PsychometricTest {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TestStatus @default(DRAFT)

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])

  dimensions Dimension[]
  invites    TestInvite[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([instituteId])
}

model Dimension {
  id   String @id @default(uuid())
  name String

  testId String
  test   PsychometricTest @relation(fields: [testId], references: [id])

  questions Question[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([testId])
}

model Question {
  id   String @id @default(uuid())
  text String

  dimensionId String
  dimension   Dimension @relation(fields: [dimensionId], references: [id])

  scaleMin Int
  scaleMax Int

  responses Response[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([dimensionId])
}

model Student {
  id    String @id @default(uuid())
  name  String
  email String

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])

  invites   TestInvite[]
  responses Response[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([instituteId])
}

model TestInvite {
  id String @id @default(uuid())

  testId    String
  studentId String

  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime?

  test    PsychometricTest @relation(fields: [testId], references: [id])
  student Student          @relation(fields: [studentId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@unique([testId, studentId])
  @@index([testId])
  @@index([studentId])
}

model Response {
  id String @id @default(uuid())

  questionId String
  studentId  String
  answer     Int

  question Question @relation(fields: [questionId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([studentId])
  @@index([questionId])
}

// DEC-02: an invitation for a staff or tenant user to create their own account. Only the SHA-256 hash of the
// token is stored. The raw token is returned once, at creation, and is never stored or logged.
model UserInvite {
  id         String    @id @default(uuid())
  email      String
  role       Role
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([instituteId])
}

// DEC-01: SUPER_ADMIN provisions tenants. ADMIN, RECRUITER and EVALUATOR work inside one institute.
// STUDENT is the candidate role. See docs/INTEGRATION_TESTING.md for the permission matrix.
enum Role {
  SUPER_ADMIN
  ADMIN
  RECRUITER
  EVALUATOR
  STUDENT
}

enum TestStatus {
  DRAFT
  PUBLISHED
}

enum InviteStatus {
  PENDING
  COMPLETED
}
