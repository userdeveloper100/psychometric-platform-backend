# Copy of this file is created as .env on first run (npm install / npm run dev / npm start).
# Replace every value marked CHANGE_ME before starting the server.
# Never commit .env: it is git-ignored. Only this template is tracked.

# Optional. HTTP port for the API (server.ts default: 5001).
PORT=5001

# Required. PostgreSQL connection string used by Prisma.
# Matches the local Docker service defined in compose.yaml.
DATABASE_URL="postgresql://psychometric:local_dev_password@localhost:5433/psychometric_db?schema=public"

# Required. Secret used to sign and verify JWTs. Minimum 32 characters; the server refuses to start otherwise.
# The placeholder below is rejected until replaced with a random value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_replace_with_random_value_of_at_least_32_chars

# Optional. JWT lifetime, e.g. 1h, 1d. Defaults to 1d (src/config/env.ts).
# JWT_EXPIRES_IN=1d

# Optional. development enables extra error details in API responses.
NODE_ENV=development

# Optional. Redis connection string. If Redis is unavailable the app still starts
# and cache/rate-limit features degrade to no-ops.
REDIS_URL=redis://localhost:6379

# Optional. Comma-separated list of allowed browser origins for CORS.
# Unset or "*" allows any origin (local development only).
CORS_ORIGINS=http://localhost:5173
